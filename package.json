{
  "name": "@callstack/eslint-config",
  "version": "16.0.0",
  "description": "ESLint flat config for React Native, React and Node.js, with TypeScript, Flow, Prettier and Jest",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "main": "./react-native.js",
  "exports": {
    ".": "./react-native.js",
    "./react-native": "./react-native.js",
    "./react-native.js": "./react-native.js",
    "./react-native.flat.js": "./react-native.js",
    "./react": "./react.js",
    "./react.js": "./react.js",
    "./react.flat.js": "./react.js",
    "./node": "./node.js",
    "./node.js": "./node.js",
    "./node.flat.js": "./node.js",
    "./package.json": "./package.json"
  },
  "homepage": "https://github.com/callstack/eslint-config-callstack#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/callstack/eslint-config-callstack.git"
  },
  "author": "Michał Pierzchała <thymikee@gmail.com>",
  "license": "MIT",
  "keywords": [
    "eslint",
    "eslint config",
    "eslint flat config",
    "callstack"
  ],
  "dependencies": {
    "@babel/core": "^8.0.6",
    "@babel/eslint-parser": "^8.0.6",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@react-native/eslint-plugin": "^0.87.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "eslint-restricted-globals": "^0.2.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "yarn --cwd=test && yarn --cwd=test workspaces run test"
